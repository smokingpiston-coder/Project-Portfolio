      script		      "function [ dIdt , Te, dwrdt ] = induction_machine_state_derivatives( is_alpha , is_beta, ir_alpha"
      " , ir_beta , us_alpha , us_beta , TL , wr , np , Rs , Rr , invL_matrix , Lr , Lm , J)\n% Description\n% Standard"
      " syntax of funtion in MATLAB:\n% funtion [ function_outputs ] =function_name( function_inputs )\n% Use the same "
      "variable names as given in the inputs and outputs of the function\n\n%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%\n%"
      " Calculating the electrical Derivatives\n\n% Defining the resistance matrix RMAT\nRMAT=[Rs,0,0,0;\n	0,Rs,0,0;\n	"
      "0,wr*Lm,Rr,wr*Lr;\n	-wr*Lm,0,-wr*Lr,Rr];\n\n% Defining the current and voltage vectors\nI_vector = [ is_alpha ; "
      "is_beta ; ir_alpha ; ir_beta ];\nU_vector = [ us_alpha ; us_beta ;        0 ;       0 ];\n\n% Calculating the 4 "
      "current derivatives\ndIdt = -invL_matrix*RMAT * I_vector + invL_matrix*U_vector;\n\n%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
      "%%%%%%%%%%%%\n% Calculating the Mechanical Derivatives\n\n% Calculating the electrodynamical torque\nTe=3*np/2*L"
      "m*(ir_alpha*is_beta-is_alpha*ir_beta);\n\n%  Calculating the rotor speed derivative  \ndwrdt=np/J*(Te-TL);\n\nen"
      "d\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
